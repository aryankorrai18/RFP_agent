# Copy to .env and fill in ONE model key. .env is git-ignored. Never commit real keys.

# Option A: Gemini (free tier works; default model gemini-3.5-flash-lite)
GEMINI_API_KEY=

# Option B: Anthropic (default model claude-opus-5)
ANTHROPIC_API_KEY=

# Option C: Groq (free tier works; default model llama-3.3-70b-versatile)
GROQ_API_KEY=

# auto (default) uses Anthropic if its key is set, then Gemini, then Groq.
# DEAL_LLM_PROVIDER=auto

# Optional overrides (defaults depend on the provider)
# DEAL_MODEL=gemini-3.5-flash-lite
# DEAL_EXTRACTION_EFFORT=low
# DEAL_BRIEF_EFFORT=medium
# DEAL_CONCURRENCY=2               # Gemini and Groq default 2 (free-tier limits), Anthropic default 8
# DEAL_MAX_UPLOAD_MB=20

# --- Memory (Hindsight) ---
# Hindsight Cloud. Get a key from your Hindsight Cloud dashboard.
# Two banks per workspace: deal interactions + closed-deal summaries (chunks mode, no Hindsight LLM)
# and outcome lessons (concise extraction, which does use Hindsight LLM credits).
DEAL_HINDSIGHT_URL=https://api.hindsight.vectorize.io
DEAL_HINDSIGHT_API_KEY=
# DEAL_HINDSIGHT_BANK=deal-interactions
# DEAL_HINDSIGHT_LESSONS_BANK=deal-lessons
# DEAL_LESSONS=true
# DEAL_SIMILAR_DEALS_K=10
# none = this deal only; longctx = all closed-deal summaries in the prompt;
# similar = recalled similar deals; hindsight = similar + structural gate + lessons
# DEAL_RETRIEVAL_MODE=hindsight
# auto (default): the free local SQLite memory (data/memory.db, keyword search, no account) when no
# Hindsight key is set and the URL is Hindsight Cloud; otherwise Hindsight. hindsight / local force one.
# DEAL_MEMORY_BACKEND=auto
# Local Hindsight instead: DEAL_HINDSIGHT_URL=http://127.0.0.1:8888 and no key.

# Where the application keeps its data (the source of truth; Hindsight only holds a search copy)
# DEAL_DB_PATH=data/deals.db
# DEAL_UPLOADS_DIR=data/uploads

# When this agent is used through the Agent Hub on a shared machine, set a secret here (and the same one in the hub's
# .env as HUB_DEAL_SERVICE_TOKEN). Every /v1 call without it is then refused. Leave unset to use this app's own screens.
# DEAL_SERVICE_TOKEN=
