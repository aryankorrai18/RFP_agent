    {
      "dot": "cyan",
      "title": "Runtime flow",
      "items": [
        "Read the deal: flags from SQLite, signals from one model call",
        "Recall similar closed deals, validate every hit, apply the structural gate",
        "Counts and warnings come from the gated deals; the model only phrases them and cites INT-/D- ids"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory",
      "items": [
        "Interactions bank: verbatim, no Hindsight LLM, so a recorded outcome changes the next brief at once",
        "Lessons bank: consolidates outcomes asynchronously; or run the same two banks locally on SQLite FTS5 with no Hindsight account"
      ]
    },
    {
      "dot": "violet",
      "title": "Isolation",
      "items": [
