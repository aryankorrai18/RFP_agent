  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Upload RFP → requirements (1 model call) → reviewer fixes the list",
        "Draft all, a resumable job: recall top 3 → draft citing FACT / ANS → check → save",
        "Reviewer accepts, edits, rewrites or rejects → export Word / Excel"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust rules",
      "items": [
        "SQLite is the source of truth; every recall hit is re-checked against it",
        "A draft may cite only the facts and past answers it was shown",
        "Unsupported → Needs SME. Only fictional data leaves the machine"
      ]
    },
    {
      "dot": "emerald",
      "title": "Library loop",
      "items": [
        "Past proposals → Q&A pairs → a person confirms each; accepted answers join too",
        "SQLite first; the outbox retains / deletes in Hindsight every 30 s",
        "Hindsight down → fact-sheet-only drafts, with a warning"
      ]
    }
  ]
