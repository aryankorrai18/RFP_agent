# Copy to .env and fill in ONE key. .env is git-ignored.

# Option A: Gemini (free tier works; default model gemini-3.5-flash-lite)
GEMINI_API_KEY=

# Option B: Anthropic (default model claude-opus-5)
ANTHROPIC_API_KEY=

# Option C: Groq (free tier works; default model llama-3.3-70b-versatile; can't read scanned PDFs)
GROQ_API_KEY=

# auto (default) uses Anthropic if its key is set, then Gemini, then Groq.
# RFP_LLM_PROVIDER=auto

# Optional overrides (defaults depend on the provider)
# RFP_MODEL=gemini-3.5-flash-lite
# RFP_EXTRACTION_EFFORT=low
# RFP_DRAFT_EFFORT=medium
# RFP_DRAFT_CONCURRENCY=2          # Gemini and Groq default 2 (free-tier limits), Anthropic default 8
# RFP_MAX_REQUIREMENTS=150
# RFP_MAX_UPLOAD_MB=20
# RFP_MAX_DOCUMENT_CHARS=400000
# RFP_FACT_SHEET=data/fact_sheet.json
# --- Answer library and memory (Hindsight) ---
# Hindsight Cloud. Get a key from your Hindsight Cloud dashboard.
# Leave the Hindsight LLM off: the app creates the bank in "chunks" mode (no LLM extraction).
RFP_HINDSIGHT_URL=https://api.hindsight.vectorize.io
RFP_HINDSIGHT_API_KEY=
# RFP_HINDSIGHT_BANK=rfp-library
# RFP_RETRIEVAL_TOP_K=3
# none = fact sheet only; plain = frozen V1 order; outcome = V2/V3 deterministic reranking
# RFP_RETRIEVAL_MODE=outcome
# RFP_RETRIEVAL_FRESHNESS_HALF_LIFE_DAYS=730
# RFP_EVIDENCE_CHECK=true
# Local Hindsight instead (see README): RFP_HINDSIGHT_URL=http://127.0.0.1:8888 and no key.

# Where the application keeps its data (the source of truth; Hindsight only holds a search copy)
# RFP_DB_PATH=data/rfp.db
# RFP_UPLOADS_DIR=data/uploads
