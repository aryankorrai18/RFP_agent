# Copy to .env and paste ONE key. .env is git-ignored. Never commit real keys.
#
# The hub's own language model. It only reads what you type and decides what to do (list deals, brief a deal,
# ask a question...). The agents keep their own models and keys for their own work.
# Without a key the hub still works with simple phrase matching.

# Gemini (free tier works; default model gemini-3.5-flash-lite)
GEMINI_API_KEY=

# Optional
# HUB_MODEL=gemini-3.5-flash-lite
# HUB_ROUTER_CAP=300        # understanding calls allowed per chat (each message that is not a plain yes/no is one)
# HUB_PLANNER=on            # off = phrase matching only, no model calls for understanding

# --- Sign-in (for when other people use the hub) ---------------------------------------------------------
# auto (default): open for one person on their own computer until the first account is made, then sign-in is required.
# on = always require it; off = never.
# HUB_AUTH=auto
# HUB_SESSION_DAYS=7
# HUB_COOKIE_SECURE=1            # set when the hub is served over https
# HUB_DATA_DIR=                  # where hub.db and uploads live (default: agent-hub/data)
#
# Make companies and accounts with:  .venv\Scripts\python.exe -m agent_hub.admin  (see the README)
#
# If the agents are not on a private machine, give each a secret and put the same one here. The agent then refuses any
# caller without it, so only the hub can reach it. (Set DEAL_SERVICE_TOKEN / RFP_SERVICE_TOKEN in each agent's .env.)
# HUB_DEAL_SERVICE_TOKEN=
# HUB_RFP_SERVICE_TOKEN=
